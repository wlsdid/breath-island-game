      m_Items: []
  - m_Id: 76
    m_Localized: "\uAC8C\uC784 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "{0}  \xB7  \uB2E8\uACC4 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "\uC9C0\uAE08\uC740 \uC785\uC9C8\uC774 \uC5C6\uC5B4\uC694. \uB2E4\uC2DC
      \uB358\uC9C0\uBA74 \uB2E4\uC74C \uC2DC\uAC04\uB300\uB97C \uC0B4\uD3B4\uBD05\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "\uC724\uC2AC\uBA78\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "\uD587\uBE5B\uC744 \uB530\uB77C \uBC18\uC9DD\uC774\uB294 \uC791\uC740
      \uBB3C\uACE0\uAE30"
