      m_Items: []
  - m_Id: 92
    m_Localized: "\uD30C\uB3C4 \uC218\uC871\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: "\uB098\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "\uC870\uC120\uACF5"
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: "\uBC14\uB2E4\uB294 \uAE30\uB2E4\uB9B4 \uC904 \uC544\uB294 \uC0AC\uB78C\uC744
      \uC88B\uC544\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: "\uC870\uC120\uC18C\uB97C \uC190\uBCF4\uBA74 \uC0B0\uD638\uCD08\uAE4C\uC9C0
      \uAC08 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: "\uC624\uB298 \uD30C\uB3C4\uB294 \uC58C\uC804\uD558\uB124. \uC904
      \uC18C\uB9AC\uC5D0 \uADC0 \uAE30\uC6B8\uC5EC \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "\uB9C8\uB8E8"
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: "\uC218\uC871\uAD00\uC9C0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: "\uCC98\uC74C \uB9CC\uB09C \uC0DD\uBB3C\uC740 \uB3C4\uAC10\uC5D0
