  m_TableData:
  - m_Id: 1
    m_Localized: "\uC228\uACB0\uC12C\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\uC5B8\uC5B4: \uD55C\uAD6D\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "{0}\uBC88 \uC2AC\uB86F\uC5D0 \uC800\uC7A5\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "{0}\uBC88 \uC2AC\uB86F\uC744 \uBD88\uB7EC\uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\uBBF8\uB07C\uAC00 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\uC904\uC774 \uB04A\uC5B4\uC84C\uC5B4\uC694. \uBBF8\uB07C\uB9CC
      \uC18C\uBAA8\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "{0}\uC774(\uAC00) \uBBF8\uB07C\uB97C \uBB3C\uC5C8\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\uD3EC\uC2DD\uC790 \uC870\uC6B0! \uACF5\uACA9 \uC2E0\uD638\uB97C
      \uBCF4\uACE0 \uD68C\uD53C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "\uAF2C\uB9AC\uCE58\uAE30\uC5D0 \uB9DE\uC558\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "\uD574\uC548\uC73C\uB85C \uB3CC\uC544\uC654\uC5B4\uC694. \uBBF8\uB07C
      1\uAC1C\uB97C \uC783\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "\uC870\uAC1C\uCF54\uC778 {0}\uAC1C\uB97C \uBC1B\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "\uC218\uC871\uAD00 \uC804\uC2DC \uBAA9\uB85D\uC5D0 \uCD94\uAC00\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "\uC7AC\uB8CC {0}\uAC1C\uB97C \uC5BB\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "\uB3C4\uAC10\uC744 \uC790\uC138\uD788 \uAE30\uB85D\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\uBB3C\uBCF4\uB77C\uB97C \uD53C\uD574 \uAD74\uB800\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\uADF8\uBB3C\uC774 \uC6C0\uC9C1\uC784\uC744 \uB2A6\uCDC4\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "\uC9C4\uC815 \uCDA9\uACA9\uC73C\uB85C \uAE30\uC6B4\uC744 \uBE90\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "\uC120\uBB3C\uC744 \uC0B4 \uCF54\uC778\uC774 \uBD80\uC871\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\uD638\uAC10\uB3C4\uAC00 \uC62C\uB790\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC \uC7AC\uB8CC\uAC00 \uBD80\uC871\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "\uC2DC\uC124\uC774 \uC131\uC7A5\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "\uC791\uC740 \uBCF4\uD2B8\uAC00 \uC644\uC131\uB410\uC5B4\uC694!"
