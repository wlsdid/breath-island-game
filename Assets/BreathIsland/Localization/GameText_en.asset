  - m_Id: 78
    m_Localized: "No bites now. Cast again to check the next hour."
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "Glimmer Anchovy"
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: "A small fish that follows sunlit ripples."
    m_Metadata:
      m_Items: []
  - m_Id: 81
    m_Localized: "Cloud Puffer"
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "It puffs up like a tiny cloud."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: "Coral Butterfly"
    m_Metadata:
      m_Items: []
  - m_Id: 84
    m_Localized: "A gentle fish that circles shallow coral."
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Moon Ray"
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "It leaves a blue trail across evening water."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "Pearl Seahorse"
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "A rare creature hiding among sea grass."
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "Breaker Shark"
    m_Metadata:
      m_Items: []
  - m_Id: 90
    m_Localized: "An open-sea predator that cuts through rough waves."
    m_Metadata:
      m_Items: []
  - m_Id: 91
    m_Localized: "Wind Boatyard"
    m_Metadata:
      m_Items: []
  - m_Id: 92
    m_Localized: "Tide Aquarium"
    m_Metadata:
      m_Items: []
  - m_Id: 93
    m_Localized: "Nari"
    m_Metadata:
      m_Items: []
  - m_Id: 94
    m_Localized: "Boatwright"
    m_Metadata:
      m_Items: []
  - m_Id: 95
    m_Localized: "The sea likes people who know how to wait."
    m_Metadata:
      m_Items: []
  - m_Id: 96
    m_Localized: "Repair the boatyard and we can reach the reef."
    m_Metadata:
      m_Items: []
  - m_Id: 97
    m_Localized: "The waves are gentle today. Listen to your line."
    m_Metadata:
      m_Items: []
  - m_Id: 98
    m_Localized: "Maru"
    m_Metadata:
      m_Items: []
  - m_Id: 99
    m_Localized: "Aquarium Keeper"
    m_Metadata:
      m_Items: []
  - m_Id: 100
    m_Localized: "Record every creature you meet for the first time."
    m_Metadata:
      m_Items: []
  - m_Id: 101
    m_Localized: "A brighter aquarium will bring people back."
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: "Cloud puffers are round, but very brave."
