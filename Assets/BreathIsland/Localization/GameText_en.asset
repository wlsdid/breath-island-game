    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "You are out of bait."
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "The line snapped. Only the bait was lost."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "A {0} took the bait!"
    m_Metadata:
      m_Items: []
